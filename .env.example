# Copy to .env and adjust. Every value is optional in development.

PORT=3000
NODE_ENV=development
# error | warn | info | debug | silent
LOG_LEVEL=info

# Required when NODE_ENV=production. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# Limit for POST /users/signup and /users/login, per client IP
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# News provider. Get a free key at https://newsapi.org/register
# Without a key the API runs, but news endpoints return no articles.
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org/v2
NEWS_API_TIMEOUT_MS=5000
NEWS_PAGE_SIZE=20

# Cache and background refresh
NEWS_CACHE_TTL_MS=600000
NEWS_CACHE_MAX_ENTRIES=500
NEWS_REFRESH_INTERVAL_MS=300000
NEWS_REFRESH_ACTIVE_WINDOW_MS=1800000
NEWS_REFRESH_MAX_QUERIES=25
